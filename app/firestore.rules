rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Existing AJ Udhar Book data remains private to the signed-in owner.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // A connection is created by the lender and then accepted by the
    // customer whose Google account is authenticated.
    match /connections/{code} {
      allow create: if request.auth != null
        && request.resource.data.lenderUid == request.auth.uid;

      allow get: if request.auth != null
        && (
          resource.data.lenderUid == request.auth.uid
          || resource.data.customerUid == request.auth.uid
          || resource.data.status == 'pending'
        );

      // Lenders query only their own active connections.
      allow list: if request.auth != null
        && resource.data.lenderUid == request.auth.uid;

      allow update: if request.auth != null
        && (
          resource.data.lenderUid == request.auth.uid
          || (
            resource.data.status == 'pending'
            && request.resource.data.lenderUid == resource.data.lenderUid
            && request.resource.data.customerUid == request.auth.uid
            && request.resource.data.status == 'active'
          )
        );

      allow delete: if request.auth != null
        && resource.data.lenderUid == request.auth.uid;

      match /events/{eventId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/connections/$(code)).data.lenderUid == request.auth.uid
            || get(/databases/$(database)/documents/connections/$(code)).data.customerUid == request.auth.uid
          );

        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/connections/$(code)).data.lenderUid == request.auth.uid;
      }
    }
  }
}
