rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function ledgerExists(ledgerId) {
      return exists(/databases/$(database)/documents/sharedLedgers/$(ledgerId));
    }

    function isOwner(ledgerId) {
      return signedIn()
        && ledgerExists(ledgerId)
        && get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.ownerUid == request.auth.uid;
    }

    function isParticipant(ledgerId) {
      return signedIn()
        && ledgerExists(ledgerId)
        && request.auth.uid in get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.participantUids;
    }

    match /sharedLedgers/{ledgerId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode == ledgerId
        && request.resource.data.participantUids.size() == 1
        && request.auth.uid in request.resource.data.participantUids;

      allow read: if isOwner(ledgerId) || isParticipant(ledgerId);

      allow update: if isOwner(ledgerId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode;

      allow delete: if isOwner(ledgerId);

      match /joinRequests/{requesterUid} {
        allow create: if signedIn()
          && request.auth.uid == requesterUid
          && ledgerExists(ledgerId)
          && request.resource.data.ledgerCode == ledgerId
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'PENDING'
          && request.auth.uid != get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.ownerUid;

        allow read: if signedIn()
          && (request.auth.uid == requesterUid || isOwner(ledgerId));

        allow update: if isOwner(ledgerId)
          && request.resource.data.requesterUid == resource.data.requesterUid
          && request.resource.data.ledgerCode == resource.data.ledgerCode
          && resource.data.status == 'PENDING'
          && request.resource.data.status in ['APPROVED', 'REJECTED'];

        allow delete: if signedIn()
          && (request.auth.uid == requesterUid || isOwner(ledgerId));
      }

      match /transactions/{transactionId} {
        allow read, create, update, delete: if isParticipant(ledgerId);
      }
    }
  }
}
