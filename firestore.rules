rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /sharedLedgers/{ledgerId} {
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.participantUids
        );
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.participantUids.size() == 1
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /joinRequests/{requesterUid} {
        allow create: if request.auth != null
          && request.auth.uid == requesterUid
          && request.resource.data.ledgerCode == ledgerId
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'PENDING'
          && exists(/databases/$(database)/documents/sharedLedgers/$(ledgerId));
        allow read: if request.auth != null
          && (
            request.auth.uid == requesterUid
            || request.auth.uid == get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.ownerUid
          );
        allow update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.ownerUid
          && request.resource.data.requesterUid == resource.data.requesterUid
          && request.resource.data.ledgerCode == resource.data.ledgerCode
          && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED'];
        allow delete: if request.auth != null
          && (
            request.auth.uid == requesterUid
            || request.auth.uid == get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.ownerUid
          );
      }

      match /transactions/{transactionId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/sharedLedgers/$(ledgerId)).data.participantUids;
      }
    }
  }
}
